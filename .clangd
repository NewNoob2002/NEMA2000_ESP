CompileFlags:
  CompilationDatabase: build
  Add:
    - -D__XTENSA__
    - -D__xtensa__
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-jump-tables
    - -fdiagnostics-color=*
    - -fmacro-prefix-map=*
    - -Werror=*
    - -ffunction-sections
    - -fdata-sections
    - -fno-builtin-*
    - -fuse-cxa-atexit
    - -gdwarf-*

Index:
  Background: Build
